	f	Ljava/lang/String;	d	field_33382	REALMS_NAMESPACE
	f	Lcom/mojang/brigadier/exceptions/SimpleCommandExceptionType;	e	field_13354	COMMAND_EXCEPTION
	f	Ljava/lang/String;	f	field_13353	namespace
	f	Ljava/lang/String;	g	field_13355	path
